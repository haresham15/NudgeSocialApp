# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgresql://nudge:nudge_dev@localhost:5432/nudge_db

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-cryptographically-strong-random-string
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Apple Sign In ────────────────────────────────────────
APPLE_CLIENT_ID=com.yourteam.nudge
APPLE_TEAM_ID=XXXXXXXXXX

# ─── Twilio Verify ───────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── AWS ──────────────────────────────────────────────
AWS_REGION=us-east-1
SQS_PROXIMITY_QUEUE_URL=
# For production: https://sqs.us-east-1.amazonaws.com/xxxx/nudge-proximity.fifo

# ─── AI Engine ────────────────────────────────────────────
ANTHROPIC_API_KEY=
YELP_FUSION_API_KEY=
APPLE_WEATHERKIT_TOKEN=
